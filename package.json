{
  "name": "style-guide-project",
  "version": "1.0.0",
  "private": true,
  "description": "Style guide for technical documentation (Docs as Code)",
  "scripts": {
    "lint": "markdownlint \"**/*.md\" --ignore node_modules --ignore site",
    "lint:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore site --fix",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.44.0"
  }
}
